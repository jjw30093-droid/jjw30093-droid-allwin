# ── 运行环境 ─────────────────────────────────────────────
# development / production。production 会启用 fail-fast 配置校验与 Secure cookie。
APP_ENV=development

# 数据目录重定向(可选;默认 <repo>/data。测试与部署共享目录用)
# ALLWIN_DATA_DIR=
# 本地媒体缓存(可选;默认 <repo>/runtime/media;生产应使用持久目录)
# ALLWIN_MEDIA_DIR=/var/lib/allwin/media

# ── 前端 API 基址(单一真源:frontend/lib/api-base.ts;宪法 §10.3) ──
# 三层解析,涉及两个变量 + 一个内置默认:
#
# 1) NEXT_PUBLIC_API_BASE —— 浏览器端基址。
#    在 `next build` 时被【内联进浏览器产物】:systemd 运行期改它对已构建
#    bundle 无效,改值必须重新 build;并且构建期与运行期取值必须一致,
#    否则 SSR 与浏览器会渲染出不同的链接(水合不一致)。
#    development / E2E:指向本机 FastAPI(如 http://127.0.0.1:8000)。
#    production:必须留空 → 浏览器走同源相对 /api/v1/*(Cloudflare → Nginx →
#    FastAPI);发布门禁 deploy/scripts/check_browser_bundle.sh 会拒绝把
#    回环地址打进浏览器产物的构建。
# NEXT_PUBLIC_API_BASE=
#
# 2) INTERNAL_API_BASE —— Next.js 服务端(RSC/route handler)基址,优先级最高。
#    仅服务端【运行期】读取:可随 systemd 环境调整,无需重新构建,绝不进入
#    浏览器产物。生产指向同机 FastAPI(http://127.0.0.1:8000),不绕 Cloudflare 回源。
# INTERNAL_API_BASE=http://127.0.0.1:8000
#
# 3) 内置默认(两者都未设置时)—— 浏览器端:同源相对 ""(绝不默认 127.0.0.1);
#    服务端:http://127.0.0.1:8000(Next 服务端与 FastAPI 同机,localhost 合法)。
#
# 注意:next build 还会读取 frontend/.env.local(shell 环境变量优先于它);
# 生产服务器与 CI 上不得存在 frontend/.env.local,否则其值会渗入构建产物。

# ── 抓取(FotMob) ────────────────────────────────────────
# ThorData 住宅代理,格式 http://user:pass@host:port。真实值只写在 .env,不进 git。
THORDATA_PROXY=

# ── 抓取(NowGoal)独立代理(2026-08-12 真实验证) ──────────
# 与上面 FotMob 用的 THORDATA_PROXY 是两个不同的 Thordata 出口配置,不能共用:
# 实测 FotMob 用的英国出口对 NowGoal 稳定失败(Thordata 服务端 403 拒绝,
# HTTPS 场景下客户端库会把这个拒绝误报成 TLS 握手失败),换一个越南出口的
# 配置则能稳定拿到真实数据——两者对同一目标为何表现不同尚未查明根因,
# 如实按经验值使用。缺失时 backend/providers/nowgoal.py 直接拒绝请求,
# 不允许静默退化成"看起来成功但数据是空的"。
THORDATA_PROXY_NOWGOAL=

# 阿里云百炼(DashScope)API Key,用于 Qwen-MT 翻译球员/球队中文名。
# 官方 SDK 约定的环境变量名就是 DASHSCOPE_API_KEY,不要改名。
# 真实 key 请直接在 .env 里手填,不要贴进对话/命令行。
DASHSCOPE_API_KEY=

# ── 认证(微信服务号:带参数二维码 + webhook 事件) ─────────
# 网页授权路线已废弃(网页授权域名要求 ICP 备案,本项目部署 AWS 东京不备案)。
# production 且 WECHAT_AUTH_ENABLED=1 时,以下缺一即拒绝启动。
WECHAT_AUTH_ENABLED=0
# real / mock。mock 仅 development 可用;production 检测到 mock 拒绝启动。
WECHAT_AUTH_PROVIDER=mock
WECHAT_OA_APP_ID=
WECHAT_OA_APP_SECRET=
# 公众号后台「设置与开发→基本配置→服务器配置」的 Token(webhook 签名校验共享密钥)。
# development 缺省用 dev-webhook-token;production 必须显式设置强随机值。
WECHAT_WEBHOOK_TOKEN=

# 对外基础地址(webhook 回调地址前缀);production 必须 https。
PUBLIC_BASE_URL=http://127.0.0.1:8000
# 登录后跳转前缀;生产同域留空(用相对路径),本地开发指向 Next dev server。
FRONTEND_BASE_URL=http://localhost:3000
# 写请求 Origin/Referer 白名单(逗号分隔)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 会话与一次性凭证有效期
SESSION_TTL_DAYS=30
OAUTH_STATE_TTL_SECONDS=600
DEVICE_REQUEST_TTL_SECONDS=300
# development 下若要强制 Secure cookie(如本地 https 调试)置 1
COOKIE_SECURE=0

# ── 管理员 CLI(非交互创建时用;交互模式走 getpass,不需要此变量) ──
# ALLWIN_ADMIN_PASSWORD=

# ── 备份 / S3(未配置时备份脚本只做本地备份,不声称已上传) ──
# S3_BACKUP_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-northeast-1

# 本地保留备份份数(deploy/scripts/backup_sqlite.sh);必须是正整数。
BACKUP_KEEP=14

# ── 发布(deploy/scripts/release.sh) ──────────────────────
# 保留最近 N 个 release 目录(current/previous 永不清理,与此值无关)。
KEEP_RELEASES=5
# 发布前磁盘可用空间下限(MB),低于此值 preflight 直接拒绝发布。
MIN_FREE_DISK_MB=2048

# ── 只读运维检查(backend/cli/ops_check.py)阈值 ──────────
# 未设置或留空 → 使用下面写的默认值。显式设置但不合法(非数字/非 finite/
# 超出合法范围)→ ops_check 立即拒绝执行(退出码 2/CRITICAL),不会静默改用
# 默认值继续检查——一个写错的阈值不应该悄悄关掉真实告警。
#
# 磁盘使用率告警/严重阈值(百分比;CLAUDE.md §14.3:70% 提醒、85% 严重)。
# 合法范围:0 < OPS_DISK_WARN_PCT < OPS_DISK_CRITICAL_PCT <= 100(拒绝负数/0/
# 超过 100/NaN/Infinity/warn>=critical)。
OPS_DISK_WARN_PCT=70
OPS_DISK_CRITICAL_PCT=85
# 本地完整备份超过多少小时未更新视为过期(每日备份,留一些缓冲)。
# 以下 4 项时间阈值均必须是严格正整数(拒绝 0/负数/小数/非数字)。
OPS_BACKUP_STALE_HOURS=30
# job_runs 里 status=running 超过多少分钟视为"卡住"。
OPS_JOB_STUCK_MINUTES=120
# 任务多少小时没有一次 succeeded 视为"过期"(所有任务用同一个阈值,
# 后续如需按任务精细化阈值,可在 ops_check.py 里扩展)。
OPS_JOB_STALE_HOURS=24
# NowGoal/FotMob 等外部数据源多少小时没有一次成功视为"过期"。
OPS_SOURCE_STALE_HOURS=6

# ── 方糖(Server 酱)告警(backend/notify;数据管道重建 Phase 5)──────
# NOTIFY_ENABLED=1 才真正推送;=0 或未设置时所有告警只落 platform.db 的
# pipeline_alerts(notify_result='suppressed:disabled'),零网络请求——
# 开发/测试环境保持 0。
NOTIFY_ENABLED=0
# Server 酱 SendKey(https://sct.ftqq.com/,免费版每天 5 条)。只放服务器
# /opt/allwin/shared/.env,绝不提交 Git;所有错误信息/日志/告警正文里该值
# 一律显示为 <REDACTED>(backend/notify 负责剥除,测试钉死)。
# production 启用推送(NOTIFY_ENABLED=1)但缺此 key 时:告警仍落库、
# notify_result='failed:misconfigured',由 ops_check 报 WARN——不 fail-fast,
# 告警通道坏了不应拖垮采集本身。
SERVERCHAN_SENDKEY=
# 每日推送配额(方糖免费版硬上限 5;本地软上限 4 条,超出后只放行 CRITICAL;
# WARNING ≤2 条/天、INFO ≤1 条/天;同一 dedup_key 24h 内只推一次)。
NOTIFY_DAILY_QUOTA=5
