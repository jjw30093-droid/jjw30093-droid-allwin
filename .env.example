# thordata proxy credential — copy this file to .env and fill in real values.
# Format matches whatever fotmob_client.py expects (typically a full proxy URL, e.g.
# http://user:pass@host:port). Do not commit the real .env file.
THORDATA_PROXY=

# 阿里云百炼(DashScope)API Key，用于 Qwen-MT 翻译球员/球队中文名。
# 官方 SDK 约定的环境变量名就是 DASHSCOPE_API_KEY，不要改名。
# 真实 key 请直接在 .env 里手填，不要贴进对话/命令行（CLAUDE.md §9）。
DASHSCOPE_API_KEY=
