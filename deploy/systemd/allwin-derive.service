# 派生数据构建(oneshot,由 allwin-derive.timer 每 30 分钟触发)。
# 目前组内只有 analysis_bundle_build 一步(2026-09-13:「关键变化」时间共现
# 功能整体下架,odds_silver_build 已移除,见 backend/migrations/odds/
# 0012_drop_cooccurrence_tables.sql)。仍走 backend.worker.group_runner
# 而不是直接单任务 timer,保持与其它 group 定时器同构、改动面最小——
# group_runner 对单元素 group 行为不变。
#
# 安装:cp allwin-derive.service allwin-derive.timer 到 /etc/systemd/system/
#       systemctl daemon-reload → systemctl enable --now allwin-derive.timer
# 手动跑一次:systemctl start allwin-derive.service
[Unit]
Description=allwin derived data build (analysis_bundle_build, every 30 minutes)
After=network.target

[Service]
Type=oneshot
User=allwin
Group=allwin
WorkingDirectory=/opt/allwin/current
EnvironmentFile=/opt/allwin/shared/.env
ExecStart=/opt/allwin/current/.venv/bin/python -m backend.worker.group_runner --group derive
TimeoutStartSec=3600
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/allwin/shared/data

[Install]
WantedBy=multi-user.target
