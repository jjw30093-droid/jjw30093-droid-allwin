[Unit]
Description=Check allwin API and database readiness
After=allwin-api.service

[Service]
Type=oneshot
EnvironmentFile=/etc/allwin/content.env
ExecStart=/usr/bin/curl --fail --silent --show-error ${ALLWIN_API_BASE}/healthz
ExecStart=/usr/bin/curl --fail --silent --show-error ${ALLWIN_API_BASE}/readyz
User=allwin
Group=allwin
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
