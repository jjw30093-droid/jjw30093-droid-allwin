# allwin Worker 任务链(oneshot,由 allwin-worker.timer 每 15 分钟触发,不常驻)
# 链内自带文件锁(data/locks/*.lock),上一轮未结束时本轮对应任务直接判 locked,不会叠跑。
#
# 用 `--periodic` 跳过 nowgoal_snapshot/fotmob_snapshot——这两步已经由
# allwin-poll.timer 每 5 分钟独立、更高频地调度;如果这里仍然裸跑 `--chain`,
# 两个定时器会争抢同一对 data/locks/<job>.lock,而 run_chain() 把"被锁"与
# "失败"同等对待,会让 15 分钟链上其余全部步骤(silver build/model predict/
# analysis bundle/postmatch settle/manifest 等——都不依赖 nowgoal/fotmob 快照
# 是否在本轮抓取)被无谓地级联跳过。
# 手动端到端重跑仍用不带 --periodic 的完整链:
#   systemctl start allwin-worker.service            (周期性,--periodic)
#   /opt/allwin/current/.venv/bin/python -m backend.worker.runner --chain   (手动全链)
#
# 安装:cp allwin-worker.service allwin-worker.timer 到 /etc/systemd/system/
#       systemctl daemon-reload → systemctl enable --now allwin-worker.timer
# 手动跑一次:systemctl start allwin-worker.service
[Unit]
Description=allwin worker chain (schedule_sync_multi -> ... -> pipeline_gates, periodic subset)
After=network.target

[Service]
Type=oneshot
User=allwin
Group=allwin
WorkingDirectory=/opt/allwin/current
EnvironmentFile=/opt/allwin/shared/.env
ExecStart=/opt/allwin/current/.venv/bin/python -m backend.worker.runner --chain --periodic
# 整链兜底时长(各任务另有自己的 timeout_seconds)
TimeoutStartSec=7200
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/allwin/shared/data

[Install]
WantedBy=multi-user.target
