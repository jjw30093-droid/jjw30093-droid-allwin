<!DOCTYPE html>
<html style="--canvas-w:{{ canvas_w }}px; --canvas-h:{{ canvas_h }}px;">
<head>
<meta charset="utf-8">
<link rel="stylesheet" href="base.css">
{% import "_chrome.html.j2" as chrome %}
<style>
  .capsule { position: absolute; left: 64px; top: 320px; background: #D23B2C; color: #ffffff;
             font-size: 28px; font-weight: 700; padding: 8px 22px; border-radius: 24px; }
  .dy-title { position: absolute; left: 64px; top: 392px; width: 816px; }
  .t1 { font-weight: 900; line-height: 1.08; color: #111820; }
  .t2 { font-weight: 900; line-height: 1.08; color: #D23B2C; }

  .avatar-row { position: absolute; left: 64px; top: 660px; width: 816px; display: flex; align-items: center; }
  .avatar-wrap { position: relative; width: 288px; height: 288px; flex-shrink: 0; }
  .avatar-wrap img.face { width: 288px; height: 288px; border-radius: 32px; object-fit: cover; box-shadow: 0 10px 24px rgba(17,24,32,0.2); }
  .avatar-wrap .badge { position: absolute; right: -12px; bottom: -12px; width: 88px; height: 88px; border-radius: 50%;
                         background: #fff; box-shadow: 0 6px 14px rgba(17,24,32,0.22); display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .avatar-wrap .badge img { width: 64px; height: 64px; object-fit: contain; }
  .stamp { margin-left: 48px; width: 156px; height: 156px; border-radius: 50%; border: 5px solid #D23B2C;
           background: rgba(255,255,255,0.9); display: flex; flex-direction: column; align-items: center; justify-content: center;
           transform: rotate(-12deg); color: #D23B2C; opacity: 0.92; flex-shrink: 0; }
  .stamp .l1 { font-size: 30px; font-weight: 900; line-height: 1.3; }
  .stamp .l2 { font-size: 28px; font-weight: 700; margin-top: 2px; }

  .cards-col { position: absolute; left: 64px; top: 986px; width: 816px; display: flex; flex-direction: column; gap: 14px; }
  .num-card { height: 116px; background: #ffffff; border-radius: 20px; display: flex; align-items: center; padding: 0 28px; box-shadow: 0 4px 12px rgba(17,24,32,0.06); }
  .num-card .left { flex: 0 0 220px; }
  .num-card .left .name { font-size: 32px; font-weight: 700; color: #111820; }
  .num-card .left .rank { font-size: 26px; font-weight: 400; color: #5B6470; margin-top: 4px; }
  .num-card .left .rank .n { color: #D23B2C; font-weight: 700; }
  .num-card .pct { flex: 1; text-align: center; font-size: 92px; font-weight: 900; color: #D23B2C; }
  .num-card .pill { flex: 0 0 140px; text-align: center; background: #D23B2C; color: #fff; font-size: 28px; font-weight: 700;
                     padding: 10px 0; border-radius: 24px; }
</style>
</head>
<body>
<div class="page">
  {{ chrome.douyin_bg_bottom() }}
  {{ chrome.douyin_brand(logo_path, column_name, issue_no, page_no) }}

  <div class="capsule">曼联球迷慎入</div>

  <div class="dy-title">
    <div class="t1" style="font-size: {{ title1_fs }}px;">{{ title1 }}</div>
    <div class="t2" style="font-size: {{ title2_fs }}px;">{{ title2 }}</div>
  </div>

  <div class="avatar-row">
    <div class="avatar-wrap">
      <img class="face" src="{{ bruno_avatar }}" alt="B费">
      <div class="badge"><img src="{{ bruno_badge }}" alt="曼联"></div>
    </div>
    <div class="stamp"><div class="l1">喵弟体检</div><div class="l2">{{ issue_no }}</div></div>
  </div>

  <div class="cards-col">
    {% for r in rows %}
    <div class="num-card">
      <div class="left">
        <div class="name">{{ r.name }}</div>
        <div class="rank">英超第1 → 第<span class="n">{{ r.rank_cur }}</span></div>
      </div>
      <div class="pct">{{ r.pct }}%</div>
      <div class="pill">异常↓</div>
    </div>
    {% endfor %}
  </div>

  {{ chrome.douyin_caveat(footer_note) }}
  {{ chrome.safezone_debug(safezone if debug_safezone else None) }}
</div>
</body>
</html>
