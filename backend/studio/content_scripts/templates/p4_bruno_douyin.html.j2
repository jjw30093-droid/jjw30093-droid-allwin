<!DOCTYPE html>
<html style="--canvas-w:{{ canvas_w }}px; --canvas-h:{{ canvas_h }}px;">
<head>
<meta charset="utf-8">
<link rel="stylesheet" href="base.css">
{% import "_chrome.html.j2" as chrome %}
<style>
  .dy-title { position: absolute; left: 64px; top: 318px; width: 816px; }
  .dy-title .page-title { font-size: 40px; line-height: 1.2; }
  .dy-id-row { position: absolute; left: 64px; top: 400px; }

  .cards-col { position: absolute; left: 64px; top: 476px; width: 816px; display: flex; flex-direction: column; gap: 12px; }
  .card { display: flex; align-items: stretch; border-radius: 16px; overflow: hidden; background: #ECEAE3; height: 110px; }
  .card.highlight { background: #ffffff; border: 3px solid #D23B2C; }
  .result-block { flex: 0 0 76px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 30px; font-weight: 900; }
  .card-mid { flex: 1; display: flex; flex-direction: column; justify-content: center; padding-left: 20px; gap: 4px; min-width: 0; }
  .card-mid .date-row { display: flex; align-items: center; gap: 10px; font-size: 28px; color: var(--ink3); }
  .card-mid .promoted-tag { display: inline-block; background: var(--gold); color: #fff; font-size: 28px; font-weight: 700; padding: 0 10px; border-radius: 4px; }
  .card-mid .hattrick-tag { display: inline-block; background: #D23B2C; color: #fff; font-size: 28px; font-weight: 700; padding: 0 10px; border-radius: 4px; }
  .card-mid .opp-row { display: flex; align-items: center; gap: 12px; }
  .card-mid .opp-row img { width: 32px; height: 32px; object-fit: contain; }
  .card-mid .opp-name { font-size: 30px; font-weight: 700; color: var(--ink); }
  .card-mid .opp-name.derby { color: #D23B2C; }
  .card-mid .score-text { font-size: 28px; color: var(--ink3); }
  .card-right { flex: 0 0 220px; display: flex; flex-direction: column; align-items: flex-end; justify-content: center; padding-right: 24px; gap: 4px; }
  .card-right .stat-main { font-size: 28px; font-weight: 900; color: var(--ink); white-space: nowrap; }
  .card.highlight .card-right .stat-main { color: #D23B2C; }
  .card-right .stat-sub { font-size: 28px; font-weight: 700; color: #D23B2C; white-space: nowrap; }

  .zero-line { position: absolute; left: 64px; top: 1080px; width: 816px; font-size: 40px; font-weight: 900; color: #111820; line-height: 1.3; }

  .vote-row { position: absolute; left: 64px; top: 1230px; width: 816px; display: flex; gap: 24px; }
  .vote-btn { flex: 1; height: 150px; border-radius: 24px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; }
  .vote-btn.yes { background: var(--gold); }
  .vote-btn.no { background: var(--red); }
  .vote-btn .big { font-size: 40px; font-weight: 900; color: #fff; }
  .vote-btn .sub { font-size: 28px; font-weight: 700; color: rgba(255,255,255,0.9); }
</style>
</head>
<body>
<div class="page">
  {{ chrome.douyin_bg_bottom() }}
  {{ chrome.douyin_brand(logo_path, column_name, issue_no, page_no) }}

  <div class="dy-title"><div class="page-title">{{ page_title }}</div></div>
  <div class="dy-id-row">{{ chrome.identity_bar(bruno_avatar, bruno_badge, bruno_age) }}</div>

  <div class="cards-col">
    {% for c in cards %}
    <div class="card {{ 'highlight' if c.is_hattrick else '' }}">
      <div class="result-block" style="background:{{ c.result_color }};">{{ c.result }}</div>
      <div class="card-mid">
        <div class="date-row">
          <span>{{ c.date }}</span>
          {% if c.promoted %}<span class="promoted-tag">升班马</span>{% endif %}
          {% if c.is_hattrick %}<span class="hattrick-tag">帽子戏法</span>{% endif %}
        </div>
        <div class="opp-row">
          <img src="{{ c.opp_badge }}" alt="">
          <span class="opp-name {{ 'derby' if c.is_derby else '' }}">{{ '曼市德比' if c.is_derby else c.opp_zh }}</span>
          <span class="score-text">{{ c.score }}</span>
        </div>
      </div>
      <div class="card-right">
        {% if c.is_derby %}
        <div class="stat-main">0球0助</div>
        <div class="stat-sub">全场{{ c.chances_created }}次关键传球</div>
        {% else %}
        <div class="stat-main">{{ c.goals }}球{{ c.assists }}助</div>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>

  <div class="zero-line">{{ zero_line }}</div>

  <div class="vote-row">
    <div class="vote-btn yes"><div class="big">还是核心</div></div>
    <div class="vote-btn no"><div class="big">不是了</div></div>
  </div>

  {{ chrome.douyin_caveat(footer_note) }}
  {{ chrome.safezone_debug(safezone if debug_safezone else None) }}
</div>
</body>
</html>
